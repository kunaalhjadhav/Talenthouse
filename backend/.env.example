# ---- App ----
NODE_ENV=production
PORT=4000
API_URL=https://api.yourdomain.com
WEB_URL=https://yourdomain.com
ADMIN_URL=https://admin.yourdomain.com

# ---- Database ----
DATABASE_URL=postgresql://platform_user:CHANGE_ME@localhost:5432/platform_db?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
JWT_ACCESS_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_LONG_RANDOM_STRING
JWT_REFRESH_EXPIRES=30d

# ---- Razorpay ----
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME

# ---- Mux (video upload/transcoding for reels) ----
MUX_TOKEN_ID=CHANGE_ME
MUX_TOKEN_SECRET=CHANGE_ME
MUX_WEBHOOK_SECRET=CHANGE_ME

# ---- Live streaming (optional — see docs/DEPLOYMENT.md "Live streaming") ----
# Uncomment and fill in once you've chosen a vendor (Agora shown as example):
# AGORA_APP_ID=CHANGE_ME
# AGORA_APP_CERTIFICATE=CHANGE_ME

# ---- SMS/OTP provider (e.g. MSG91 / Twilio) ----
SMS_PROVIDER_API_KEY=CHANGE_ME
SMS_SENDER_ID=TALENT

# ---- Firebase (push notifications) ----
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- Google Maps ----
GOOGLE_MAPS_API_KEY=CHANGE_ME

# ---- Object storage (S3-compatible) ----
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
S3_BUCKET=talent-platform-media
S3_REGION=ap-south-1
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
CDN_BASE_URL=https://cdn.yourdomain.com

# ---- Email ----
EMAIL_PROVIDER_API_KEY=CHANGE_ME
EMAIL_FROM=no-reply@yourdomain.com
