NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://platform_user:CHANGE_ME@localhost:5432/platform_db?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_LONG_RANDOM_STRING
JWT_REFRESH_EXPIRES=30d
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
GOOGLE_MAPS_API_KEY=
SMSLOCAL_API_KEY=
SMSLOCAL_SENDER_ID=
SMSLOCAL_ROUTE=
SMSLOCAL_DLT_TEMPLATE_ID=
SMSLOCAL_OTP_TEMPLATE="Your OTP for Talent Platform is {otp}. It is valid for 5 minutes."
SMS_SEND_IN_DEV=false

# --- Payments testing ---
# Local only. With no real Razorpay keys, orders are created as "order_dev_*" and the app confirms
# them through POST /payments/dev/confirm/:id. Ignored when NODE_ENV=production.
ALLOW_DEV_PAYMENTS=true
