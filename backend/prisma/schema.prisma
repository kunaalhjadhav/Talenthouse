generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  FINANCE_ADMIN
  CONTENT_MODERATOR
  SUPPORT_ADMIN
  CONTEST_MANAGER
  TALENT_MANAGER
  HOST
  JUDGE
  RECRUITER
  TALENT
  PARTICIPANT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
  PENDING_VERIFICATION
  DELETED
}

enum ContestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUIRED
  APPROVED
  REJECTED
  LIVE
  REGISTRATION_CLOSED
  ONGOING
  COMPLETED
  CANCELLED
}

enum ContestMode {
  ONLINE
  OFFLINE
  HYBRID
}

enum RegistrationStatus {
  PENDING_PAYMENT
  REGISTERED
  DISQUALIFIED
  WITHDRAWN
}

enum AuditionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  LIVE
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  SELECTED_FOR_AUDITION
  REJECTED
  SELECTED
  CONTRACTED
  COMPLETED
}

enum BookingStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  ADVANCE_PAID
  CONFIRMED
  PERFORMED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum PaymentPurpose {
  CONTEST_REGISTRATION
  VOTING
  BOOKING_ADVANCE
  BOOKING_BALANCE
  SUBSCRIPTION
  TIP
  VOTE_PACK
  OTHER
}

enum WalletTxnType {
  CREDIT
  DEBIT
  HOLD
  RELEASE
  WITHDRAWAL
  REFUND
  ADJUSTMENT
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum AvailabilityStatus {
  AVAILABLE
  BOOKED
  TENTATIVE
  UNAVAILABLE
  BLOCKED
}

enum WithdrawalStatus {
  REQUESTED
  APPROVED
  PROCESSING
  PAID
  REJECTED
  FAILED
}

enum RatingTargetType {
  TALENT
  HOST
  RECRUITER
  JUDGE
  BOOKING
}

enum DisputeType {
  BOOKING
  CONTEST
  PAYMENT
  REFUND
  TALENT_PERFORMANCE
  HOST_CANCELLATION
  NO_SHOW
  AUDITION
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_REFUND
  RESOLVED_PAYOUT
  RESOLVED_NO_ACTION
  REJECTED
}

enum SubscriptionPlan {
  FREE
  PREMIUM
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum AdType {
  BANNER
  VIDEO
  REEL
  SPONSORED_TALENT
  SPONSORED_CONTEST
  NATIVE
}

enum AdStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum LiveSessionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

model User {
  id            String     @id @default(uuid())
  mobile        String     @unique
  email         String?    @unique
  name          String?
  passwordHash  String?
  role          UserRole   @default(PARTICIPANT)
  status        UserStatus @default(PENDING_VERIFICATION)
  profilePhoto  String?
  city          String?
  latitude      Float?
  longitude     Float?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  profile         Profile?
  talentProfile   TalentProfile?
  judgeProfile    JudgeProfile?
  wallet          Wallet?
  kyc             Kyc?
  contestsHosted  Contest[]           @relation("HostContests")
  registrations   ContestRegistration[]
  auditionsPosted Audition[]          @relation("RecruiterAuditions")
  applications    AuditionApplication[]
  bookingsAsCustomer Booking[]        @relation("CustomerBookings")
  votes           Vote[]
  reels           Reel[]
  notifications   Notification[]
  otpCodes        OtpCode[]
  refreshTokens   RefreshToken[]
  following       Follow[]            @relation("Following")
  followers       Follow[]            @relation("Followers")
  xp              Int                 @default(0)
  streak          Int                 @default(0)
  lastCheckIn     DateTime?
  badges          UserBadge[]
  tipsSent        Tip[]               @relation("TipFrom")
  tipsReceived    Tip[]               @relation("TipTo")
  battleVotes     BattleVote[]

  @@index([role])
  @@index([status])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("Following", fields: [followerId], references: [id])
  followingId String
  followingUser User   @relation("Followers", fields: [followingId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
  @@index([followerId])
}

model Profile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id])
  bio                String?
  category           String?
  skills             String[]
  experienceYears    Int?
  languages          String[]
  verificationStatus KycStatus @default(NOT_SUBMITTED)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model OtpCode {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  mobile    String
  codeHash  String
  purpose   String   @default("LOGIN")
  expiresAt DateTime
  consumed  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([mobile, purpose])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String
  deviceId  String?
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Wallet {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id])
  balance            Decimal  @default(0) @db.Decimal(14, 2)
  pendingBalance     Decimal  @default(0) @db.Decimal(14, 2)
  withdrawableBalance Decimal @default(0) @db.Decimal(14, 2)
  currency           String   @default("INR")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  transactions WalletTransaction[]
}

model WalletTransaction {
  id          String        @id @default(uuid())
  walletId    String
  wallet      Wallet        @relation(fields: [walletId], references: [id])
  type        WalletTxnType
  amount      Decimal       @db.Decimal(14, 2)
  balanceAfter Decimal      @db.Decimal(14, 2)
  reference   String?
  description String?
  createdAt   DateTime      @default(now())

  @@index([walletId])
}

model Kyc {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id])
  panNumber     String?
  bankAccountNo String?
  ifsc          String?
  accountHolder String?
  status        KycStatus @default(NOT_SUBMITTED)
  rejectionNote String?
  submittedAt   DateTime?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model WithdrawalRequest {
  id            String           @id @default(uuid())
  userId        String
  amount        Decimal          @db.Decimal(14, 2)
  status        WithdrawalStatus @default(REQUESTED)
  payoutReference String?
  rejectionNote String?
  requestedAt   DateTime         @default(now())
  processedAt   DateTime?

  @@index([userId])
  @@index([status])
}

model CommissionRule {
  id          String   @id @default(uuid())
  scope       String
  key         String
  percentage  Decimal  @db.Decimal(5, 2)
  fixedFee    Decimal? @db.Decimal(14, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scope, key])
}

model Category {
  id        String   @id @default(uuid())
  type      String
  name      String
  slug      String
  icon      String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  parentId  String?
  createdAt DateTime @default(now())

  @@unique([type, slug])
}

model Contest {
  id                String         @id @default(uuid())
  hostId            String
  host              User           @relation("HostContests", fields: [hostId], references: [id])
  title             String
  description       String
  category          String
  subcategory       String?
  bannerUrl         String?
  promoVideoUrl     String?
  rules             String?
  minAge            Int?
  maxAge            Int?
  genderEligibility String?
  mode              ContestMode    @default(ONLINE)
  venueAddress      String?
  latitude          Float?
  longitude         Float?
  registrationOpensAt  DateTime
  registrationClosesAt DateTime
  startDate         DateTime
  endDate           DateTime
  entryFee          Decimal        @db.Decimal(14, 2) @default(0)
  maxParticipants   Int?
  numWinners        Int            @default(1)
  prizePool         Decimal        @db.Decimal(14, 2) @default(0)
  commissionPct     Decimal?       @db.Decimal(5, 2)
  publicVotingEnabled Boolean      @default(false)
  votingFee         Decimal?       @db.Decimal(14, 2)
  judgeWeightPct    Decimal        @db.Decimal(5, 2) @default(70)
  voteWeightPct     Decimal        @db.Decimal(5, 2) @default(30)
  status            ContestStatus  @default(DRAFT)
  rejectionNote     String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  rounds        ContestRound[]
  registrations ContestRegistration[]
  judges        ContestJudge[]
  scoringCriteria ScoringCriterion[]
  votes         Vote[]
  awards        ContestAward[]
  payments      Payment[]

  @@index([status])
  @@index([category])
}

model ContestRound {
  id        String   @id @default(uuid())
  contestId String
  contest   Contest  @relation(fields: [contestId], references: [id])
  name      String
  order     Int
  startDate DateTime?
  endDate   DateTime?
}

model ScoringCriterion {
  id         String  @id @default(uuid())
  contestId  String
  contest    Contest @relation(fields: [contestId], references: [id])
  name       String
  weightPct  Decimal @db.Decimal(5, 2)
}

model ContestRegistration {
  id            String              @id @default(uuid())
  contestId     String
  contest       Contest             @relation(fields: [contestId], references: [id])
  userId        String
  user          User                @relation(fields: [userId], references: [id])
  paymentId     String?
  status        RegistrationStatus  @default(PENDING_PAYMENT)
  performanceUrl String?
  judgeScore    Decimal?            @db.Decimal(6, 2)
  publicVoteScore Decimal?          @db.Decimal(6, 2)
  finalScore    Decimal?            @db.Decimal(6, 2)
  rank          Int?
  goldenBuzzer  Boolean             @default(false)
  judgeFeedback String?
  createdAt     DateTime            @default(now())

  scores JudgeScore[]

  @@unique([contestId, userId])
}

model ContestJudge {
  id        String   @id @default(uuid())
  contestId String
  contest   Contest  @relation(fields: [contestId], references: [id])
  judgeId   String
  judge     JudgeProfile @relation(fields: [judgeId], references: [id])
  feeAgreed Decimal? @db.Decimal(14, 2)
  paid      Boolean  @default(false)

  @@unique([contestId, judgeId])
}

model JudgeScore {
  id             String   @id @default(uuid())
  registrationId String
  registration   ContestRegistration @relation(fields: [registrationId], references: [id])
  judgeUserId    String
  criterion      String
  score          Decimal  @db.Decimal(6, 2)
  comment        String?
  createdAt      DateTime @default(now())
}

model ContestAward {
  id        String  @id @default(uuid())
  contestId String
  contest   Contest @relation(fields: [contestId], references: [id])
  title     String
  registrationId String?
  prizeDescription String?
}

model Vote {
  id          String   @id @default(uuid())
  contestId   String
  contest     Contest  @relation(fields: [contestId], references: [id])
  registrationId String
  voterId     String
  voter       User     @relation(fields: [voterId], references: [id])
  isPaid      Boolean  @default(false)
  amount      Decimal? @db.Decimal(14, 2)
  deviceFingerprint String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([contestId, registrationId])
}

model JudgeProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  category     String?
  bio          String?
  isCelebrity  Boolean  @default(false)
  baseFee      Decimal? @db.Decimal(14, 2)
  verified     Boolean  @default(false)
  rating       Decimal? @db.Decimal(3, 2)
  createdAt    DateTime @default(now())

  contests ContestJudge[]
}

model Audition {
  id               String   @id @default(uuid())
  recruiterId      String
  recruiter        User     @relation("RecruiterAuditions", fields: [recruiterId], references: [id])
  title            String
  companyName      String?
  category         String
  designation      String?
  posterUrl        String?
  description      String
  requirements     String?
  minAge           Int?
  maxAge           Int?
  gender           String?
  location         String?
  latitude         Float?
  longitude        Float?
  compensation     String?
  applicationDeadline DateTime
  auditionDate     DateTime?
  numOpenings      Int      @default(1)
  status           AuditionStatus @default(DRAFT)
  createdAt        DateTime @default(now())

  applications AuditionApplication[]
}

model AuditionApplication {
  id          String            @id @default(uuid())
  auditionId  String
  audition    Audition          @relation(fields: [auditionId], references: [id])
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  portfolioUrls String[]
  resumeUrl   String?
  status      ApplicationStatus @default(APPLIED)
  slot        DateTime?
  createdAt   DateTime          @default(now())

  @@unique([auditionId, userId])
}

model TalentProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  stageName     String?
  category      String
  skills        String[]
  basePrice     Decimal  @db.Decimal(14, 2)
  serviceRadiusKm Int?
  city          String?
  latitude      Float?
  longitude     Float?
  rating        Decimal? @db.Decimal(3, 2)
  verified      Boolean  @default(false)
  portfolioUrls String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  availability CalendarSlot[]
  bookings     Booking[]
}

model CalendarSlot {
  id        String              @id @default(uuid())
  talentId  String
  talent    TalentProfile       @relation(fields: [talentId], references: [id])
  date      DateTime
  startTime String
  endTime   String
  status    AvailabilityStatus  @default(AVAILABLE)

  @@index([talentId, date])
}

model Booking {
  id             String        @id @default(uuid())
  customerId     String
  customer       User          @relation("CustomerBookings", fields: [customerId], references: [id])
  talentId       String
  talent         TalentProfile @relation(fields: [talentId], references: [id])
  eventType      String?
  eventDate      DateTime
  startTime      String?
  endTime        String?
  venueAddress   String?
  latitude       Float?
  longitude      Float?
  amount         Decimal       @db.Decimal(14, 2)
  advancePct     Decimal       @db.Decimal(5, 2) @default(30)
  advanceAmount  Decimal       @db.Decimal(14, 2)
  balanceAmount  Decimal       @db.Decimal(14, 2)
  commissionPct  Decimal?      @db.Decimal(5, 2)
  status         BookingStatus @default(REQUESTED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  payments Payment[]
}

model Payment {
  id              String         @id @default(uuid())
  userId          String
  purpose         PaymentPurpose
  amount          Decimal        @db.Decimal(14, 2)
  currency        String         @default("INR")
  status          PaymentStatus  @default(INITIATED)
  razorpayOrderId String?        @unique
  razorpayPaymentId String?
  razorpaySignature String?
  contestId       String?
  contest         Contest?       @relation(fields: [contestId], references: [id])
  bookingId       String?
  booking         Booking?       @relation(fields: [bookingId], references: [id])
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
}

model Reel {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  videoUrl    String
  thumbnailUrl String?
  category    String
  caption     String?
  hashtags    String[]
  views       Int      @default(0)
  likes       Int      @default(0)
  shares      Int      @default(0)
  status      String   @default("PUBLISHED")
  muxAssetId    String?
  muxPlaybackId String?
  createdAt   DateTime @default(now())
  tipsList    Tip[]

  @@index([status, category])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String
  type      String
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Rating {
  id           String           @id @default(uuid())
  raterId      String
  targetType   RatingTargetType
  targetId     String
  stars        Int
  review       String?
  moderated    Boolean          @default(false)
  hidden       Boolean          @default(false)
  createdAt    DateTime         @default(now())

  @@unique([raterId, targetType, targetId])
  @@index([targetType, targetId])
}

model Dispute {
  id           String        @id @default(uuid())
  raisedById   String
  type         DisputeType
  referenceId  String
  description  String
  evidenceUrls String[]
  status       DisputeStatus @default(OPEN)
  resolutionNote String?
  resolvedBy   String?
  createdAt    DateTime      @default(now())
  resolvedAt   DateTime?

  @@index([status])
  @@index([raisedById])
}

model Referral {
  id            String   @id @default(uuid())
  referrerId    String
  refereeId     String   @unique
  code          String
  bonusAmount   Decimal? @db.Decimal(14, 2)
  bonusPaid     Boolean  @default(false)
  qualifyingActionAt DateTime?
  createdAt     DateTime @default(now())

  @@index([referrerId])
}

model Subscription {
  id        String             @id @default(uuid())
  userId    String             @unique
  plan      SubscriptionPlan   @default(FREE)
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now())
  expiresAt DateTime?
  autoRenew Boolean            @default(false)
  lastPaymentId String?

  @@index([plan])
}

model Advertisement {
  id          String   @id @default(uuid())
  title       String
  type        AdType
  mediaUrl    String?
  targetUrl   String?
  placement   String
  category    String?
  city        String?
  startDate   DateTime
  endDate     DateTime
  budget      Decimal? @db.Decimal(14, 2)
  status      AdStatus @default(DRAFT)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([status, placement])
}

model LiveSession {
  id           String            @id @default(uuid())
  hostId       String
  contestId    String?
  title        String
  thumbnailUrl String?
  status       LiveSessionStatus @default(SCHEDULED)
  provider     String            @default("none")
  providerRoomId String?
  isPaid       Boolean           @default(false)
  price        Decimal?          @db.Decimal(14, 2)
  scheduledAt  DateTime?
  startedAt    DateTime?
  endedAt      DateTime?
  viewerCount  Int               @default(0)
  createdAt    DateTime          @default(now())

  @@index([status])
  @@index([hostId])
}

model Conversation {
  id          String    @id @default(uuid())
  participantAId String
  participantBId String
  context     String?
  createdAt   DateTime  @default(now())
  lastMessageAt DateTime @default(now())

  messages    Message[]

  @@unique([participantAId, participantBId, context])
  @@index([participantAId])
  @@index([participantBId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  body           String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  module    String
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  createdAt DateTime @default(now())
}

// ---------- Feature pack v2 ----------
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  badge     String
  awardedAt DateTime @default(now())

  @@unique([userId, badge])
}

model Tip {
  id         String   @id @default(uuid())
  fromUserId String
  from       User     @relation("TipFrom", fields: [fromUserId], references: [id])
  toUserId   String
  to         User     @relation("TipTo", fields: [toUserId], references: [id])
  reelId     String?
  reel       Reel?    @relation(fields: [reelId], references: [id])
  amount     Decimal  @db.Decimal(14, 2)
  paymentId  String?
  createdAt  DateTime @default(now())

  @@index([toUserId])
}

model Battle {
  id          String   @id @default(uuid())
  title       String
  reelAId     String
  reelBId     String
  votesA      Int      @default(0)
  votesB      Int      @default(0)
  status      String   @default("LIVE")
  winnerReelId String?
  createdAt   DateTime @default(now())
  endsAt      DateTime?

  votes BattleVote[]

  @@index([status])
}

model BattleVote {
  id       String @id @default(uuid())
  battleId String
  battle   Battle @relation(fields: [battleId], references: [id])
  voterId  String
  voter    User   @relation(fields: [voterId], references: [id])
  side     String
  createdAt DateTime @default(now())

  @@unique([battleId, voterId])
}

model ContestBuzzer {
  id             String   @id @default(uuid())
  contestId      String
  judgeUserId    String
  registrationId String
  createdAt      DateTime @default(now())

  @@unique([contestId, judgeUserId])
}
